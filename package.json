  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verificar:cor": "node scripts/verificar-contraste.mjs",
    "verificar:rotas": "node scripts/verificar-rotas.mjs",
    "verificar:moeda": "node --experimental-strip-types --no-warnings scripts/verificar-moeda.mjs",
    "verificar:url": "node --experimental-strip-types --no-warnings scripts/verificar-url.mjs",
    "verificar:whatsapp": "node --experimental-strip-types --no-warnings --import ./scripts/registrar-resolver.mjs scripts/verificar-whatsapp.mjs",
    "verificar": "npm run typecheck && npm run lint && npm run verificar:cor && npm run verificar:rotas && npm run verificar:moeda && npm run verificar:url && npm run verificar:whatsapp",
    "testar": "playwright test",
    "testar:ui": "playwright test --ui",
