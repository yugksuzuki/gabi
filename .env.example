# Copie para .env.local. NADA DE SEGREDO NO REPOSITÓRIO (docs/01 §7.3).

# URL canônica do site. Define canônica, hreflang, Open Graph e sitemap.
# EM ABERTO: ela comprou gclm.com.br (dez/2024), mas os contatos são
# @gseleme.design. Ninguém amarrou as pontas — ver CLAUDE.md, "Em aberto".
# Na Vercel, sem esta variável, cai na URL de produção do próprio projeto.
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business, só dígitos, E.164 sem o "+".
# NÃO CONFIRMADO. O número informado (+55 44 9992-9186) tem 8 dígitos onde
# celular brasileiro tem 9. Candidato mais provável: 5544999929186.
# Teste abrindo https://wa.me/5544999929186 no celular ANTES de preencher.
# Vazio = o botão Consultar cai no mailto:, e o site sobe sem isso.
NEXT_PUBLIC_WHATSAPP=

# Libera a indexação. Só depois que E5 fechar e não houver [PENDENTE]
# em rota publicada. Qualquer valor diferente de 1 mantém o site fechado.
ABRIR_INDEXACAO=
